{
    "swagger": "2.0",
    "info": {
        "description": "Backend API for the Fleet Management System (vehicles, devices, telemetry).",
        "title": "Karlo FMS API",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/api/v1",
    "paths": {
        "/healthz": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/vehicles": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vehicles"
                ],
                "summary": "List vehicles",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.Vehicle"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.Vehicle": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "make": {
                    "type": "string"
                },
                "model": {
                    "type": "string"
                },
                "plate_no": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        }
    }
}