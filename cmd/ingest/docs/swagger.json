{
    "swagger": "2.0",
    "info": {
        "description": "Multi-vendor device telemetry intake. Devices POST readings; each is reverse-geocoded (kecamatan/kota/provinsi) and stored to the telemetry hypertable keyed by IMEI.",
        "title": "Karlo FMS Ingest Service",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/",
    "paths": {
        "/reverse": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "geocode"
                ],
                "summary": "Reverse geocode a coordinate to kecamatan / kota / provinsi",
                "parameters": [
                    {
                        "type": "number",
                        "example": -6.1751,
                        "description": "Latitude",
                        "name": "lat",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "example": 106.8272,
                        "description": "Longitude",
                        "name": "lon",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/geocode.Result"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/history/{imei}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "read"
                ],
                "summary": "Historical track for a device over a time range",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device IMEI",
                        "name": "imei",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Start time (RFC3339); default now-24h",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End time (RFC3339); default now",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page size (default 1000, max 10000)",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Pass the previous response's next_cursor to get the next page",
                        "name": "cursor",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Comma-separated columns to return (e.g. lat,lon,speed); omit for all. imei+time always included. Dropping metadata is the biggest speed/size win.",
                        "name": "fields",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Downsample the whole range to ~N shape-preserving points (LTTB). When set, pagination is bypassed.",
                        "name": "max_points",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ingest.HistoryPage"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/ingest": {
            "post": {
                "description": "Accepts all readings, reverse-geocodes each to kecamatan/kota/provinsi, and stores them to the telemetry hypertable keyed by IMEI. Send one GenericReading object or a JSON array of them. Fields map to telemetry columns except those noted \"-\u003e metadata\" (stored in the metadata jsonb).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "ingest"
                ],
                "summary": "Ingest device telemetry (single reading or batch array)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Shared ingest API key (required when the service is configured with one)",
                        "name": "X-Ingest-Key",
                        "in": "header"
                    },
                    {
                        "description": "A reading (or a JSON array of readings)",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ingest.GenericReading"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/ingest.IngestResult"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/live": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "read"
                ],
                "summary": "Latest position of every device",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Comma-separated columns to return (e.g. lat,lon,speed); omit for all. imei+time always included.",
                        "name": "fields",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/ingest.Position"
                            }
                        }
                    }
                }
            }
        },
        "/v1/live/{imei}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "read"
                ],
                "summary": "Latest position of one device",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device IMEI",
                        "name": "imei",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ingest.Position"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "geocode.Result": {
            "type": "object",
            "properties": {
                "Kota": {
                    "description": "city (empty if the ADM2 is a regency)",
                    "type": "string"
                },
                "cached": {
                    "description": "true if served from the Redis cache",
                    "type": "boolean"
                },
                "found": {
                    "type": "boolean"
                },
                "jalan": {
                    "description": "nearest OSM street (empty if none within range)",
                    "type": "string"
                },
                "kabupaten": {
                    "description": "regency (empty if the ADM2 is a city)",
                    "type": "string"
                },
                "kecamatan": {
                    "type": "string"
                },
                "kelurahan": {
                    "description": "village (empty until ADM4 data is loaded)",
                    "type": "string"
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "provinsi": {
                    "type": "string"
                }
            }
        },
        "ingest.GenericReading": {
            "type": "object",
            "properties": {
                "altitude": {
                    "description": "altitude -\u003e metadata",
                    "type": "number",
                    "example": 20
                },
                "bearing": {
                    "description": "heading degrees (float) -\u003e bearing column",
                    "type": "number",
                    "example": 106.5
                },
                "gpsCreatedAt": {
                    "description": "dateGps (device fix time) -\u003e time column. received_at is stamped by the server, not sent here.",
                    "type": "string",
                    "example": "2026-07-10T06:12:29Z"
                },
                "ignitionOn": {
                    "description": "ignition on/off -\u003e ignition column",
                    "type": "boolean",
                    "example": false
                },
                "imei": {
                    "description": "device IMEI (required)",
                    "type": "string",
                    "example": "864454076648348"
                },
                "io": {
                    "description": "full vendor io blob -\u003e metadata",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "latitude": {
                    "description": "GPS latitude  -\u003e geom column",
                    "type": "number",
                    "example": -6.68211
                },
                "longitude": {
                    "description": "GPS longitude -\u003e geom column",
                    "type": "number",
                    "example": 111.4544916
                },
                "sat": {
                    "description": "satellite count -\u003e metadata",
                    "type": "integer",
                    "example": 14
                },
                "speed": {
                    "description": "speed -\u003e speed column",
                    "type": "number",
                    "example": 0
                }
            }
        },
        "ingest.HistoryPage": {
            "type": "object",
            "properties": {
                "next_cursor": {
                    "type": "string"
                },
                "points": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                }
            }
        },
        "ingest.IngestResult": {
            "type": "object",
            "properties": {
                "stored": {
                    "description": "number of readings written",
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "ingest.Position": {
            "type": "object",
            "properties": {
                "bearing": {
                    "type": "number"
                },
                "ignition": {
                    "type": "boolean"
                },
                "imei": {
                    "type": "string"
                },
                "jalan": {
                    "type": "string"
                },
                "kabupaten": {
                    "type": "string"
                },
                "kecamatan": {
                    "type": "string"
                },
                "kelurahan": {
                    "type": "string"
                },
                "kota": {
                    "type": "string"
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "metadata": {
                    "description": "vendor io + extras (raw payload excluded)",
                    "type": "object"
                },
                "provinsi": {
                    "type": "string"
                },
                "received_at": {
                    "type": "string"
                },
                "speed": {
                    "type": "number"
                },
                "time": {
                    "description": "gpsCreatedAt",
                    "type": "string"
                }
            }
        }
    }
}