{
    "swagger": "2.0",
    "info": {
        "description": "Multi-vendor device telemetry intake. Devices POST readings; each is reverse-geocoded (kecamatan/kota/provinsi) and stored to the telemetry hypertable keyed by IMEI.",
        "title": "Karlo FMS Ingest Service",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/",
    "paths": {
        "/v1/history/{imei}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "read"
                ],
                "summary": "Historical track for a device over a time range",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device IMEI",
                        "name": "imei",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Start time (RFC3339); default now-24h",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "End time (RFC3339); default now",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Max points (default 1000, max 10000)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/ingest.Position"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/ingest/{vendor}": {
            "post": {
                "description": "Accepts all readings, reverse-geocodes each to kecamatan/kota/provinsi, and stores them to the telemetry hypertable keyed by IMEI. Send one GenericReading object or a JSON array of them. Fields map to telemetry columns except those noted \"-\u003e metadata\" (stored in the metadata jsonb).",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "ingest"
                ],
                "summary": "Ingest device telemetry (single reading or batch array)",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Vendor/adapter key (e.g. generic)",
                        "name": "vendor",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "A reading (or a JSON array of readings)",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/ingest.GenericReading"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/ingest.IngestResult"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/live": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "read"
                ],
                "summary": "Latest position of every device",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/ingest.Position"
                            }
                        }
                    }
                }
            }
        },
        "/v1/live/{imei}": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "read"
                ],
                "summary": "Latest position of one device",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Device IMEI",
                        "name": "imei",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/ingest.Position"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "ingest.GenericReading": {
            "type": "object",
            "properties": {
                "altitude": {
                    "description": "altitude -\u003e metadata",
                    "type": "number",
                    "example": 20
                },
                "bearing": {
                    "description": "heading degrees -\u003e bearing column",
                    "type": "number",
                    "example": 106
                },
                "createdAt": {
                    "description": "dateCreated (server receive) -\u003e received_at column",
                    "type": "string",
                    "example": "2026-07-10T13:12:31.530Z"
                },
                "gpsCreatedAt": {
                    "description": "dateGps (device fix time) -\u003e time column",
                    "type": "string",
                    "example": "2026-07-10T06:12:29Z"
                },
                "ignitionOn": {
                    "description": "ignition on/off -\u003e ignition column",
                    "type": "boolean",
                    "example": false
                },
                "imei": {
                    "description": "device IMEI (required)",
                    "type": "string",
                    "example": "864454076648348"
                },
                "io": {
                    "description": "full vendor io blob -\u003e metadata",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "latitude": {
                    "description": "GPS latitude  -\u003e geom column",
                    "type": "number",
                    "example": -6.68211
                },
                "longitude": {
                    "description": "GPS longitude -\u003e geom column",
                    "type": "number",
                    "example": 111.4544916
                },
                "sat": {
                    "description": "satellite count -\u003e metadata",
                    "type": "integer",
                    "example": 14
                },
                "speed": {
                    "description": "speed -\u003e speed column",
                    "type": "number",
                    "example": 0
                }
            }
        },
        "ingest.IngestResult": {
            "type": "object",
            "properties": {
                "stored": {
                    "description": "number of readings written",
                    "type": "integer",
                    "example": 1
                }
            }
        },
        "ingest.Position": {
            "type": "object",
            "properties": {
                "bearing": {
                    "type": "number"
                },
                "ignition": {
                    "type": "boolean"
                },
                "imei": {
                    "type": "string"
                },
                "kabupaten": {
                    "type": "string"
                },
                "kecamatan": {
                    "type": "string"
                },
                "kota": {
                    "type": "string"
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "provinsi": {
                    "type": "string"
                },
                "received_at": {
                    "type": "string"
                },
                "speed": {
                    "type": "number"
                },
                "time": {
                    "description": "gpsCreatedAt",
                    "type": "string"
                }
            }
        }
    }
}