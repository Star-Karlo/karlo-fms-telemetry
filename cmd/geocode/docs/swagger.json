{
    "swagger": "2.0",
    "info": {
        "description": "Two jobs behind one process: geocoding (lat/lon -\u003e kecamatan / kota / provinsi, PostGIS + Redis geohash cache; /search for forward lookups) and the platform's routing cache (/v1/route, /v1/route-toll — MAPID's answers kept 90 days in Postgres so the same lane is never bought twice). They share a service because they share a database and a deploy, not because they are the same thing: geocode answers from our own data, routing caches somebody else\\'s.",
        "title": "Karlo FMS Geocode Service",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/",
    "paths": {
        "/reverse": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "geocode"
                ],
                "summary": "Reverse geocode a coordinate to kecamatan / kota / provinsi",
                "parameters": [
                    {
                        "type": "number",
                        "example": -6.1751,
                        "description": "Latitude",
                        "name": "lat",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "example": 106.8272,
                        "description": "Longitude",
                        "name": "lon",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/geocode.Result"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/search": {
            "get": {
                "security": [
                    {
                        "ServiceToken": []
                    }
                ],
                "description": "Searches the service's own road and administrative-area data (no external provider). \"Jl. Raya Bekasi, Cikarang Utara\": the part before the first comma is the road or area, the rest narrows the area. Roads first, then kelurahan / kecamatan / kabupaten. Not house-number precise. Requires a platform service token as Bearer.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "geocode"
                ],
                "summary": "Forward geocode: an address or place name to candidate pins (Indonesia)",
                "parameters": [
                    {
                        "type": "string",
                        "example": "Jl. Raya Bekasi, Cikarang",
                        "description": "query, at least 3 characters",
                        "name": "q",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "max candidates (default 10, max 25)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/geocode.Candidate"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/route": {
            "post": {
                "security": [
                    {
                        "ServiceToken": []
                    }
                ],
                "description": "MAPID's routing answer for these points, served from the shared cache when it has been asked before and bought upstream when it has not. For a journey whose FARE you also need, call /v1/route-toll instead — its answer already contains the route. The response carries MAPID's payload untouched under `payload`, plus whether it was cached. Points are [lon, lat] in travel order; order is part of the identity, so A→B and B→A are different journeys.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "routing"
                ],
                "summary": "Route between points (cached)",
                "parameters": [
                    {
                        "description": "points + profile",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/routecache.RouteRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/routecache.Answer"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "MAPID refused or was unreachable; its own message is passed through",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/route-cache/purge": {
            "post": {
                "security": [
                    {
                        "ServiceToken": []
                    }
                ],
                "description": "A cached answer is only as true as the place it was computed for. Coordinates change when a warehouse moves, so those entries simply go unused — but a LOCATION ID does not change, and would keep serving the route to where the warehouse used to be until it expires. Call this with the id when a location moves, or with lon/lat (+radius, default 200 m) to drop every journey touching a point.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "routing"
                ],
                "summary": "Drop cached journeys for a place that has moved",
                "parameters": [
                    {
                        "description": "location_id, or lon+lat",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/routecache.PurgeRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "{\\\"purged\\\": n}",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "integer",
                                "format": "int64"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/route-ids": {
            "post": {
                "security": [
                    {
                        "ServiceToken": []
                    }
                ],
                "description": "MAPID's /v4/route, which takes Karlo's own location ids registered with MAPID rather than coordinates — it may know a yard or gate centroid that a dropped pin does not hit, so its answer can differ from the coordinate route for the same pair. Cached on the id pair, which is a steadier key than coordinates. A pair MAPID does not recognise comes back 502 and is not cached, so a caller can fall back to /v1/route exactly as it does today. If a location MOVES, call /v1/route-cache/purge with its id — the id does not change when the place does.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "routing"
                ],
                "summary": "Route between two Karlo location ids (cached)",
                "parameters": [
                    {
                        "description": "two location ids, loading point first",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/routecache.RouteIDsRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/routecache.Answer"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/route-toll": {
            "post": {
                "security": [
                    {
                        "ServiceToken": []
                    }
                ],
                "description": "As /v1/route, with MAPID's toll pricing. IF YOU NEED BOTH THE ROUTE AND THE FARE, CALL ONLY THIS: the payload carries `route`, `distance` and `eta` alongside `prices`, so asking /v1/route as well buys a second answer for something you already have — and one computation means the fare and the geometry cannot describe slightly different roads. `prices` is the total per golongan, the figure to use; `details` are the gates as evidence, naming both ends of each segment, and their prices are a partition of the total rather than charges to add up. All five golongan come back in one answer, so the caller picks its class and the cache holds one entry per journey rather than five.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "routing"
                ],
                "summary": "Route with toll fares (cached)",
                "parameters": [
                    {
                        "description": "points + profile",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/routecache.RouteRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/routecache.Answer"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "geocode.Address": {
            "type": "object",
            "properties": {
                "kabupaten": {
                    "type": "string"
                },
                "kecamatan": {
                    "type": "string"
                },
                "kelurahan": {
                    "type": "string"
                },
                "provinsi": {
                    "type": "string"
                }
            }
        },
        "geocode.Candidate": {
            "type": "object",
            "properties": {
                "address": {
                    "$ref": "#/definitions/geocode.Address"
                },
                "kind": {
                    "description": "road | kelurahan | kecamatan | kabupaten",
                    "type": "string"
                },
                "label": {
                    "description": "display string, composed once for every caller",
                    "type": "string"
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "name": {
                    "type": "string"
                },
                "score": {
                    "description": "0..1 match quality",
                    "type": "number"
                }
            }
        },
        "geocode.Result": {
            "type": "object",
            "properties": {
                "Kota": {
                    "description": "city (empty if the ADM2 is a regency)",
                    "type": "string"
                },
                "cached": {
                    "description": "true if served from the Redis cache",
                    "type": "boolean"
                },
                "found": {
                    "type": "boolean"
                },
                "jalan": {
                    "description": "nearest OSM street (empty if none within range)",
                    "type": "string"
                },
                "kabupaten": {
                    "description": "regency (empty if the ADM2 is a city)",
                    "type": "string"
                },
                "kecamatan": {
                    "type": "string"
                },
                "kelurahan": {
                    "description": "village (empty until ADM4 data is loaded)",
                    "type": "string"
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "provinsi": {
                    "type": "string"
                }
            }
        },
        "routecache.Answer": {
            "type": "object",
            "properties": {
                "cached": {
                    "type": "boolean"
                },
                "cached_at": {
                    "type": "string"
                },
                "hits": {
                    "type": "integer"
                },
                "payload": {
                    "type": "object"
                },
                "source": {
                    "description": "mapid — the provider that produced it",
                    "type": "string"
                }
            }
        },
        "routecache.PurgeRequest": {
            "type": "object",
            "properties": {
                "lat": {
                    "type": "number"
                },
                "location_id": {
                    "description": "LocationID drops every journey naming this id.",
                    "type": "string"
                },
                "lon": {
                    "description": "Lon/Lat/RadiusM drops every journey with a point within the radius\n(default 200 m) — the coordinate equivalent.",
                    "type": "number"
                },
                "radius_m": {
                    "type": "number"
                }
            }
        },
        "routecache.RouteIDsRequest": {
            "type": "object",
            "properties": {
                "location_ids": {
                    "description": "LocationIDs: exactly two, loading point first.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "routecache.RouteRequest": {
            "type": "object",
            "properties": {
                "points": {
                    "description": "Points are [lon, lat] in TRAVEL ORDER — MAPID's order, and the order\nthe cache keys on.",
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "number",
                            "format": "float64"
                        }
                    }
                },
                "profile": {
                    "description": "truck (default) | car | motorcycle | foot",
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "ServiceToken": {
            "description": "Platform service token as \"Bearer \u003ctoken\u003e\" — required for /search and for every routing endpoint (they front a PAID upstream). /reverse stays open.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}