{
    "swagger": "2.0",
    "info": {
        "description": "Reverse geocoding: lat/lon -\u003e kecamatan / kota / provinsi (PostGIS + Redis geohash cache).",
        "title": "Karlo FMS Geocode Service",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/",
    "paths": {
        "/reverse": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "geocode"
                ],
                "summary": "Reverse geocode a coordinate to kecamatan / kota / provinsi",
                "parameters": [
                    {
                        "type": "number",
                        "example": -6.1751,
                        "description": "Latitude",
                        "name": "lat",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "example": 106.8272,
                        "description": "Longitude",
                        "name": "lon",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/geocode.Result"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/search": {
            "get": {
                "security": [
                    {
                        "ServiceToken": []
                    }
                ],
                "description": "Searches the service's own road and administrative-area data (no external provider). \"Jl. Raya Bekasi, Cikarang Utara\": the part before the first comma is the road or area, the rest narrows the area. Roads first, then kelurahan / kecamatan / kabupaten. Not house-number precise. Requires a platform service token as Bearer.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "geocode"
                ],
                "summary": "Forward geocode: an address or place name to candidate pins (Indonesia)",
                "parameters": [
                    {
                        "type": "string",
                        "example": "Jl. Raya Bekasi, Cikarang",
                        "description": "query, at least 3 characters",
                        "name": "q",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "max candidates (default 10, max 25)",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/geocode.Candidate"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "geocode.Address": {
            "type": "object",
            "properties": {
                "kabupaten": {
                    "type": "string"
                },
                "kecamatan": {
                    "type": "string"
                },
                "kelurahan": {
                    "type": "string"
                },
                "provinsi": {
                    "type": "string"
                }
            }
        },
        "geocode.Candidate": {
            "type": "object",
            "properties": {
                "address": {
                    "$ref": "#/definitions/geocode.Address"
                },
                "kind": {
                    "description": "road | kelurahan | kecamatan | kabupaten",
                    "type": "string"
                },
                "label": {
                    "description": "display string, composed once for every caller",
                    "type": "string"
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "name": {
                    "type": "string"
                },
                "score": {
                    "description": "0..1 match quality",
                    "type": "number"
                }
            }
        },
        "geocode.Result": {
            "type": "object",
            "properties": {
                "Kota": {
                    "description": "city (empty if the ADM2 is a regency)",
                    "type": "string"
                },
                "cached": {
                    "description": "true if served from the Redis cache",
                    "type": "boolean"
                },
                "found": {
                    "type": "boolean"
                },
                "jalan": {
                    "description": "nearest OSM street (empty if none within range)",
                    "type": "string"
                },
                "kabupaten": {
                    "description": "regency (empty if the ADM2 is a city)",
                    "type": "string"
                },
                "kecamatan": {
                    "type": "string"
                },
                "kelurahan": {
                    "description": "village (empty until ADM4 data is loaded)",
                    "type": "string"
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "provinsi": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "ServiceToken": {
            "description": "Platform service token as \"Bearer \u003ctoken\u003e\" — /search is for peer services (TMS business-service); /reverse stays open.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}