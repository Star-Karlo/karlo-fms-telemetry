{
    "swagger": "2.0",
    "info": {
        "description": "Reverse geocoding: lat/lon -\u003e kecamatan / kota / provinsi (PostGIS + Redis geohash cache).",
        "title": "Karlo FMS Geocode Service",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/",
    "paths": {
        "/healthz": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "system"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/reverse": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "geocode"
                ],
                "summary": "Reverse geocode a coordinate to kecamatan / kota / provinsi",
                "parameters": [
                    {
                        "type": "number",
                        "example": -6.1751,
                        "description": "Latitude",
                        "name": "lat",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "number",
                        "example": 106.8272,
                        "description": "Longitude",
                        "name": "lon",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/geocode.Result"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/vehicles": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "vehicles"
                ],
                "summary": "List vehicles",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/api.Vehicle"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.Vehicle": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer"
                },
                "make": {
                    "type": "string"
                },
                "model": {
                    "type": "string"
                },
                "plate_no": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "geocode.Result": {
            "type": "object",
            "properties": {
                "cached": {
                    "description": "true if served from the Redis cache",
                    "type": "boolean"
                },
                "found": {
                    "type": "boolean"
                },
                "kabupaten": {
                    "description": "kota/kabupaten = the \"city\" level",
                    "type": "string"
                },
                "kecamatan": {
                    "type": "string"
                },
                "kecamatan_code": {
                    "description": "BPS P-code",
                    "type": "string"
                },
                "lat": {
                    "type": "number"
                },
                "lon": {
                    "type": "number"
                },
                "provinsi": {
                    "type": "string"
                }
            }
        }
    }
}