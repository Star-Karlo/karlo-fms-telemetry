{
    "swagger": "2.0",
    "info": {
        "description": "Cached MAPID routing and toll pricing, shared by the Karlo platform's services. Every endpoint requires a platform service token — a paid upstream is never behind an open door.",
        "title": "Karlo Routing Cache",
        "contact": {},
        "version": "0.1"
    },
    "basePath": "/",
    "paths": {
        "/v1/route": {
            "post": {
                "security": [
                    {
                        "ServiceToken": []
                    }
                ],
                "description": "MAPID's routing answer for these points, served from the shared cache when it has been asked before and bought upstream when it has not. The response carries MAPID's payload untouched under `payload`, plus whether it was cached. Points are [lon, lat] in travel order; order is part of the identity, so A→B and B→A are different journeys.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "routing"
                ],
                "summary": "Route between points (cached)",
                "parameters": [
                    {
                        "description": "points + profile",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/routecache.RouteRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/routecache.Answer"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "MAPID refused or was unreachable; its own message is passed through",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/v1/route-toll": {
            "post": {
                "security": [
                    {
                        "ServiceToken": []
                    }
                ],
                "description": "As /v1/route, with MAPID's toll pricing. The payload carries `prices` (the total per golongan — the figure to use) and `details` (the gates, as evidence: the per-gate prices are a partition of the total, not charges to add up). All five golongan come back in one answer, so the caller picks the class it needs and the cache holds one entry per journey rather than five.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "routing"
                ],
                "summary": "Route with toll fares (cached)",
                "parameters": [
                    {
                        "description": "points + profile",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/routecache.RouteRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/routecache.Answer"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "routecache.Answer": {
            "type": "object",
            "properties": {
                "cached": {
                    "type": "boolean"
                },
                "cached_at": {
                    "type": "string"
                },
                "hits": {
                    "type": "integer"
                },
                "payload": {
                    "type": "object"
                },
                "source": {
                    "description": "mapid — the provider that produced it",
                    "type": "string"
                }
            }
        },
        "routecache.RouteRequest": {
            "type": "object",
            "properties": {
                "points": {
                    "description": "Points are [lon, lat] in TRAVEL ORDER — MAPID's order, and the order\nthe cache keys on.",
                    "type": "array",
                    "items": {
                        "type": "array",
                        "items": {
                            "type": "number",
                            "format": "float64"
                        }
                    }
                },
                "profile": {
                    "description": "truck (default) | car | motorcycle | foot",
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "ServiceToken": {
            "description": "Platform service token as \"Bearer \u003ctoken\u003e\".",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}